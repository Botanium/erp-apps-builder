# Server-side variables only. Never prefix secrets with NEXT_PUBLIC_.
# Leave paid features off until Botan explicitly authorizes a bounded live test.
OPENAI_API_KEY=
SHOP_AI_ENABLED=false
SHOP_AI_BUDGET_MICRO_USD=0
SHOP_VOICE_ENABLED=false
SHOP_VOICE_PRICING_REVIEWED=

# Hosted owner access requires all four. Locally prefer npm run owner:configure.
DATABASE_URL=
SHOP_APP_ORIGIN=
SHOP_OWNER_PASSWORD_HASH=
SHOP_SESSION_SECRET=

# Optional local-only SQLite overrides. Keep owner, preview and auth separate.
# SHOP_DB_PATH=.local/shop.sqlite
# SHOP_PREVIEW_DB_PATH=.local/shop-preview.sqlite
# SHOP_AUTH_DB_PATH=.local/shop-auth.sqlite
